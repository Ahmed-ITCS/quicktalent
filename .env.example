# --- App ---
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5000

# --- Supabase (alternative backend — leave empty if using Airtable) ---
# Leave SUPABASE_URL empty to run in local dev mode (SQLite, seeded demo data).
# Use your anon key if RLS is disabled; use the service role key if RLS is enabled.
SUPABASE_URL=
SUPABASE_KEY=

# --- Airtable (primary backend — set these to use Airtable) ---
# Personal access token: https://airtable.com/create/tokens  (create with
# data.records:read/write on your base). Base ID: Airtable base URL after /app.
# Table names must match the schema in AIRTABLE_SETUP.md (a table ID like
# tblXXXX also works and is more robust with the new Airtable Pages UI).
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CANDIDATES_TABLE=Candidates
AIRTABLE_HR_TABLE=HR Accounts
AIRTABLE_CONTACTS_TABLE=Contacts
# Field used for newest/oldest sorting (override when the base lacks "Created At").
AIRTABLE_SORT_FIELD=Created At
# --- Optional Airtable field-name overrides ---
# Only needed if your Airtable columns use different names than the canonical
# schema (e.g. lowercase "email", "City" instead of "Location", "Verified status").
# Candidates:  AIR_NAME, AIR_EMAIL, AIR_PHONE, AIR_JOB_TITLE, AIR_LOCATION,
#              AIR_LINKEDIN, AIR_SKILLS, AIR_YEARS_EXPERIENCE, AIR_LAST_EMPLOYER,
#              AIR_RESUME, AIR_STATUS
# HR accounts: AIRHR_EMAIL, AIRHR_PASSWORD_HASH, AIRHR_COMPANY_NAME, AIRHR_PHONE,
#              AIRHR_ROLE, AIRHR_VERIFIED, AIRHR_BLOCKED
# Contacts:    AIRCONTACT_HR_ID, AIRCONTACT_CANDIDATE_ID, AIRCONTACT_STATUS
# Example:
# AIR_EMAIL=email
# AIR_LOCATION=City
# AIRHR_VERIFIED=Verified status

# --- SMTP email ---
# Leave SMTP_HOST empty for console mode (emails are written to var/mail.log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QuickTalent <no-reply@yourdomain.com>

# --- God account (seeded on first boot; role = admin) ---
GOD_EMAIL=god@quicktalent.dev
GOD_PASSWORD=ChangeMeGod123!
